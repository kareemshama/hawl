{
  "name": "hawl",
  "private": true,
  "version": "0.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w @hawl/desktop -- dev",
    "build:desktop": "npm run tauri -w @hawl/desktop -- build",
    "web": "npm run dev -w @hawl/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
